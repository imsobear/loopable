{
  "name": "loopable-cli",
  "version": "0.4.0",
  "description": "Connect your machine to Loopable: a runner that does your workspace's jobs with your own coding agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loopable": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/runner.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsobear/loopable.git"
  },
  "bugs": {
    "url": "https://github.com/imsobear/loopable/issues"
  },
  "homepage": "https://loop.goodone.si",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dispatcher": "LOOPABLE_DEV=1 node --experimental-strip-types src/dispatcher/main.ts",
    "runner": "LOOPABLE_DEV=1 node --experimental-strip-types src/cli.ts runner",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/build-cli.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "LOOPABLE_DEV=1 drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "deploy": "LOOPABLE_CF=1 vite build && wrangler deploy",
    "site:deploy": "pnpm --filter loopable-site run deploy",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/vite-plugin": "^1.54.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.39.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
