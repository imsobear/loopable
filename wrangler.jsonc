{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loopable",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "observability": { "enabled": true },
  "vars": {
    // The App Worker never migrates; the dispatcher container does, once.
    "LOOPABLE_SKIP_MIGRATE": "1",
    // Where OAuth callbacks, sign-in and runner logins come back to.
    "LOOPABLE_BASE_URL": "https://loop.goodone.si"
  },
  // The site lives here now: the front page is the app's /. Secrets
  // (database, master key, OAuth apps) are set with wrangler secret put;
  // see docs/hosting.md.
  "routes": [{ "pattern": "loop.goodone.si", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "containers": [
    {
      "class_name": "DispatcherContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPATCHER",
        "class_name": "DispatcherContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DispatcherContainer"]
    }
  ]
}
